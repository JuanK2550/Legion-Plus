# Plantilla de configuracion. Copiala como `.env` y rellena los valores.
# `.env` NUNCA se sube al repositorio: lo ignora .gitignore.

# Firma los tokens JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Usuario y contrasena del administrador (los pide /login y el panel de admin).
ADMIN_USER=
ADMIN_PASSWORD=

# Clave gratuita de https://www.themoviedb.org -> Ajustes -> API
TMDB_API_KEY=

# Opcionales (si se omiten se usan estos valores):
# MINUTOS_EXPIRACION_TOKEN=60
# MAX_INTENTOS=5
# SEGUNDOS_BLOQUEO=300

# Sal del esquema de claves anterior. Dejar vacia salvo que haya una base
# antigua cuyas claves de perfil haya que seguir aceptando.
SAL_LEGADA=

# 1 solo para desarrollar en tu PC. En la entrega va en 0.
FLASK_DEBUG=0
